# ============================================================
# RemoteScope — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- General ---
APP_ENV=development          # development | staging | production
APP_NAME=RemoteScope
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=remotescope
POSTGRES_USER=remotescope
POSTGRES_PASSWORD=changeme_postgres
DATABASE_URL=postgresql://remotescope:changeme_postgres@postgres:5432/remotescope?sslmode=disable

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis
REDIS_URL=redis://:changeme_redis@redis:6379/0

# --- Backend (Go API) ---
BACKEND_PORT=8080
JWT_SECRET=changeme_jwt_secret_min_32_chars_long
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_nextauth_secret_min_32_chars

# --- OAuth Providers ---
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/github/callback

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/linkedin/callback

# --- AI Service ---
AI_SERVICE_URL=http://ai_service:8001
AI_SERVICE_PORT=8001

# OpenAI (for embeddings + classification)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Alternatively: self-hosted via Ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Scraper Service ---
SCRAPER_PORT=8002
SCRAPER_CONCURRENCY=10
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_USER_AGENT=RemoteScope/1.0 (job aggregator; contact@remotescope.app)

# Rate limits (per source, requests per minute)
SCRAPER_DEFAULT_RATE_LIMIT=30

# --- Notification Service ---
NOTIFICATION_SERVICE_PORT=8003

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=notifications@remotescope.app
EMAIL_FROM_NAME=RemoteScope

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@remotescope.app

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RemoteScopeBot

# Discord
DISCORD_WEBHOOK_URL=

# Slack
SLACK_WEBHOOK_URL=

# SMS (Twilio) - Phase 2
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Queue Configuration ---
QUEUE_SCRAPE=q:scrape
QUEUE_PARSE=q:parse
QUEUE_CLASSIFY=q:classify
QUEUE_EMBED=q:embed
QUEUE_DEDUPLICATE=q:deduplicate
QUEUE_NOTIFY=q:notify
QUEUE_INDEX=q:index
QUEUE_DEAD_LETTER=q:dead-letter

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# --- Security ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=30
BCRYPT_COST=12

# --- Feature Flags ---
ENABLE_AI_CLASSIFICATION=true
ENABLE_DEDUPLICATION=true
ENABLE_FAKE_DETECTION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_TELEGRAM=false
ENABLE_DISCORD=false
ENABLE_SLACK=false

# --- Admin ---
ADMIN_EMAIL=admin@remotescope.app
ADMIN_PASSWORD=changeme_admin_password

# --- S3 (logos, exports) ---
# S3_BUCKET=remotescope-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=  # Leave blank for AWS, set for MinIO
